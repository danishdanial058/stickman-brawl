; Stickman Brawl: Godot 4 test build (one fighter, one arena). The live game is still the HTML version in docs/.
config_version=5

[application]

config/name="Stickman Brawl Godot Test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.874, 0.898, 0.941, 1)
anti_aliasing/quality/msaa_2d=1
textures/vram_compression/import_etc2_astc=true
